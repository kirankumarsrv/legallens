HUGGINGFACE_API_TOKEN=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
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# === WEB SEARCH APIS (Optional - Choose at least one) ===
# Tavily Search (recommended for legal research)
# Get key: https://tavily.com
TAVILY_API_KEY=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

# Google Search via SerpAPI
# Get key: https://serpapi.com
SERP_API_KEY=REDACTED

# Bing Search
# Get key: https://www.bing.com/webmaster/tools/
BING_SEARCH_V7_SUBSCRIPTION_KEY=your-bing-search-key-here

# DuckDuckGo (free, no API key needed)
DUCKDUCKGO_ENABLED=false

# === RESEARCH PAPER APIS (Free) ===
# Arxiv academic paper search (no API key needed)
ARXIV_ENABLED=true

# Local PDF directory for semantic search
PDF_RESEARCH_DIRECTORY=./research_papers

# === Vector Store Configuration ===
CHROMA_PERSISTENCE_DIR=./vector_db/chroma
FAISS_PERSISTENCE_DIR=./vector_db/faiss

# === Database & Session Storage ===
# Options: memory | sqlite | postgresql
SESSION_STORAGE_TYPE=memory
SQLITE_DB_PATH=./data/sessions.db

# PostgreSQL (optional, for multi-user support)
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-password-here
POSTGRESQL_DATABASE=legal_ai

# === Application Configuration ===
ENVIRONMENT=development
DEBUG=true

# Fact gathering limits
MAX_FACTS_PER_PHASE=10
MAX_ARGUMENTS_PER_ANALYSIS=8
SESSION_TIMEOUT_MINUTES=120

# === Feature Flags ===
ENABLE_MULTI_SOURCE_RETRIEVAL=true
ENABLE_WEB_SEARCH=true
ENABLE_RESEARCH_PAPERS=true

# === Source Weights (0-1, higher = more priority) ===
VECTOR_STORE_WEIGHT=1.0
WEB_SEARCH_WEIGHT=0.7
RESEARCH_PAPER_WEIGHT=0.8
MANUAL_INPUT_WEIGHT=1.0


