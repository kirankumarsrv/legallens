# ============================================================
# LEGAL AI SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git - add to .gitignore
#
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Get API keys from respective providers
# 3. Fill in the keys below
# 4. Save and restart your application
#
# ============================================================


# ============================================================
# LLM PROVIDER (Required)
# ============================================================

# Groq API (currently used for legal analysis)
# Get key: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here


# ============================================================
# WEB SEARCH TOOLS (Optional - Choose at least one)
# ============================================================

# OPTION 1: Tavily Search (Recommended for legal research)
# - Best for legal documents, case law, statutes
# - Free tier available
# - Get key: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# OPTION 2: Google Search via SerpAPI
# - Most comprehensive web search
# - Free tier available
# - Get key: https://serpapi.com
SERP_API_KEY=your-serpapi-key-here

# OPTION 3: Bing Search
# - Alternative to Google
# - Free tier available
# - Get key: https://www.bing.com/webmaster/tools/
BING_SEARCH_V7_SUBSCRIPTION_KEY=your-bing-search-key-here

# OPTION 4: DuckDuckGo (Free, no API key needed)
# - Privacy-focused search
# - No API key required
# - Just set to "enabled" if you want to use it
DUCKDUCKGO_ENABLED=false


# ============================================================
# RESEARCH PAPER TOOLS (Optional)
# ============================================================

# Arxiv Search (Free, no API key needed)
# - 2+ million academic papers
# - Legal research papers, law reviews
# - Just set to "enabled" if you want to use it
ARXIV_ENABLED=true

# Local PDF Directory for semantic search
# - Path to directory containing research PDFs
# - Optional: leave empty if not using local PDFs
PDF_RESEARCH_DIRECTORY=./research_papers


# ============================================================
# EMBEDDING MODEL CONFIGURATION (Optional)
# ============================================================

# Hugging Face model for embeddings
# Default: sentence-transformers/all-mpnet-base-v2
# Other options:
#   - sentence-transformers/all-MiniLM-L6-v2 (faster, smaller)
#   - sentence-transformers/paraphrase-MiniLM-L6-v2
#   - sentence-transformers/all-distilroberta-v1
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Hugging Face API token (if using custom models)
# Get token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your-huggingface-token-here


# ============================================================
# VECTOR STORE CONFIGURATION (Optional)
# ============================================================

# Chroma vector store persistence
CHROMA_PERSISTENCE_DIR=./vector_db/chroma

# FAISS vector store persistence
FAISS_PERSISTENCE_DIR=./vector_db/faiss


# ============================================================
# DATABASE & STORAGE (Optional - for STEP 7)
# ============================================================

# Session storage type: memory | sqlite | postgresql
SESSION_STORAGE_TYPE=memory

# SQLite configuration (if using SESSION_STORAGE_TYPE=sqlite)
SQLITE_DB_PATH=./data/sessions.db

# PostgreSQL configuration (if using SESSION_STORAGE_TYPE=postgresql)
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-password-here
POSTGRESQL_DATABASE=legal_ai


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Application environment
ENVIRONMENT=development
# Options: development | production | testing

# Debug mode (verbose logging)
DEBUG=true

# Maximum number of facts to retrieve per phase
MAX_FACTS_PER_PHASE=10

# Maximum number of arguments per analysis
MAX_ARGUMENTS_PER_ANALYSIS=8

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=120

# Enable multi-source retrieval
ENABLE_MULTI_SOURCE_RETRIEVAL=true

# Enable web search in fact gathering
ENABLE_WEB_SEARCH=true

# Enable research paper search
ENABLE_RESEARCH_PAPERS=true

# Source weights for fact retrieval (0-1)
VECTOR_STORE_WEIGHT=1.0
WEB_SEARCH_WEIGHT=0.7
RESEARCH_PAPER_WEIGHT=0.8
MANUAL_INPUT_WEIGHT=1.0


# ============================================================
# API KEY SETUP GUIDE
# ============================================================
#
# QUICK START (Minimum Setup):
# 1. Get GROQ_API_KEY from https://console.groq.com (required)
# 2. Get TAVILY_API_KEY from https://tavily.com (recommended for legal search)
# 3. Set the rest to "enabled" if you want those features
#
# WEB SEARCH OPTIONS:
# - Tavily: Best for legal research, 30 free requests/day
# - Google (SerpAPI): Most comprehensive, 100 free requests/month
# - Bing: Works in restricted regions
# - DuckDuckGo: Free, no API key, no limits but less structured
#
# FULL SETUP (All features):
# 1. GROQ_API_KEY - required
# 2. TAVILY_API_KEY - highly recommended
# 3. SERP_API_KEY - optional, for Google search
# 4. ARXIV_ENABLED - free, no key needed
# 5. EMBEDDING_MODEL - uses local model (no key needed)
#
# FOR PRODUCTION (STEP 7+):
# - Add PostgreSQL credentials for multi-user support
# - Add authentication tokens for API endpoints
# - Add SSL certificates for HTTPS
#
# ============================================================
