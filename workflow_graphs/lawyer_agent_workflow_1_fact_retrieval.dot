digraph G {
  rankdir=LR;
  node [shape=box, style=rounded, fontsize=12];
  entry [label="ENTRY", shape=circle, style=filled, fillcolor=lightgrey];
  exit [label="FINISH", shape=doublecircle, style=filled, fillcolor=lightgrey];
  "evidence_ingest";
  "entity_extraction";
  "entity_normalization";
  "fact_gathering";
  entry -> "evidence_ingest";
  "evidence_ingest" -> "entity_extraction";
  "entity_extraction" -> "entity_normalization";
  "entity_normalization" -> "fact_gathering";
  "fact_gathering" -> exit;
}
