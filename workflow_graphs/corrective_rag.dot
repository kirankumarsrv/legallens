digraph G {
  rankdir=LR;
  node [shape=box, style=rounded, fontsize=12];
  entry [label="ENTRY", shape=circle, style=filled, fillcolor=lightgrey];
  exit [label="FINISH", shape=doublecircle, style=filled, fillcolor=lightgrey];
  "retrieve";
  "grade";
  "answer";
  entry -> "retrieve";
  "retrieve" -> "grade";
  "grade" -> "answer";
  "answer" -> exit;
}
